  <!-- ======================================================= -->
  <!-- BOX DEFINITION (attached to the human's hand)         -->
  <!-- ======================================================= -->
  <link name="box">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="2.0"/>
      <inertia ixx="0.5" iyy="0.5" izz="0.5" ixy="0" ixz="0" iyz="0"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <!-- Bounding box for the object: dimensions ~ 0.3149 x 0.4317 x 0.2267 -->
        <box size="0.314917 0.226704 0.431696"/>
      </geometry>
      <material name="Brown">
        <color rgba="0.7 0.4 0.2 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.314917 0.226704 0.431696"/>
      </geometry>
    </collision>
  </link>

  <!-- ======================================================= -->
  <!-- TABLE DEFINITION                                     -->
  <!-- ======================================================= -->
  <!-- Using the three markers (NEAR, FARR, FARL), we compute a centroid and approximate orientation.
       Here we use the centroid as the table's pose relative to the world. -->
  <link name="table">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="10.0"/>
      <inertia ixx="1.0" iyy="1.0" izz="1.0" ixy="0" ixz="0" iyz="0"/>
    </inertial>

    <visual>
      <!-- For simplicity, we define the table geometry in its own frame -->
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <!-- Approximate bounding box dimensions computed from markers -->
      <geometry>
        <!-- For example, length ≈ 0.4763, width ≈ 0.6976, thickness = 0.05 -->
        <box size="0.4763 0.6976 0.05"/>
      </geometry>
      <material name="Grey">
        <color rgba="0.6 0.6 0.6 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.4763 0.6976 0.05"/>
      </geometry>
    </collision>
  </link>

  <!-- Joint attaching the table to the world using the computed table frame.
       From your markers, the centroid was computed as:
         (0.893744, -0.011544, 0.579767)
       and the computed rpy was approximately (-0.00932, -0.01177, 0.00935). -->
  <joint name="world_to_table" type="fixed">
    <parent link="world"/>
    <child link="table"/>
    <origin xyz="0.813744 0.100544 0.549767"
            rpy="-0.00932 -0.01177 0.00935"/>
  </joint>
</robot>
