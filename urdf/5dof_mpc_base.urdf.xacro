<?xml version="1.0" encoding="utf-8"?>
<robot name = "human_5dof" xmlns:xacro="http://wiki.ros.org/xacro">

<!-- Load the YAML files for calibration -->
<xacro:property name="anthropometry_yaml_file" value="$(find rt-cosmik)/config/human_params/human_anthropometry.yaml"/>
<xacro:property name="human_segment_lengths" value="${xacro.load_yaml(anthropometry_yaml_file)}"/>
<xacro:property name="world_to_human_yaml_file" value="$(find rt-cosmik)/config/human_params/c1_human_color_test_test.yaml"/>
<xacro:property name="human_base" value="${xacro.load_yaml(world_to_human_yaml_file)}"/>
<!-- Properties -->
<xacro:property name="translation" value="${human_base['translation_vector']['data']}" />
<xacro:property name="rotation" value="${human_base['rotation_rpy']['data']}" />
<xacro:property name="elbow_length" value="${human_segment_lengths['Elbow']}" />
<xacro:property name="hip_length" value="${human_segment_lengths['Hip']}" />
<xacro:property name="knee_length" value="${human_segment_lengths['Knee']}" />
<xacro:property name="shoulder_length" value="${human_segment_lengths['Shoulder']}" />
<xacro:property name="wrist_length" value="${human_segment_lengths['Wrist']}" />
  
  <link name="world" />
  <joint name="world_to_human" type="fixed">
    <origin xyz="${translation[0]} ${translation[1]} ${translation[2]}"
            rpy="${rotation[0]} ${rotation[1]} ${rotation[2]}" />
    <axis xyz="0 0 1"/>
    <parent link="world"/>
    <child link="foot"/>
  </joint>
  <material name="body_color">
    <texture />
    <color rgba="0.005 0.005 0.005 0.6" />
  </material>
  <link name="foot">
    <inertial>
      <mass value="0.9" />
      <origin rpy="0 0 0" xyz="0.068 -0.027 0.005" />
      <inertia ixx="0.000815" ixy="0.000477" ixz="-0.00018" iyy="0.00386" iyz="0.0" izz="0.003654" />
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="-0 0 0.1" />
      <geometry>
        <mesh filename="package://meshes/foot_mesh.STL" scale="0.0060 0.0060 0.0060" />
      </geometry>
      <material name="body_color">
        <texture />
        <color rgba="0 1 1 0.5" />
      </material>
    </visual>
    <visual>
      <origin rpy="0 0 0" xyz="0 0.0 -0.1" />
      <geometry>
        <mesh filename="package://meshes/foot_mesh.STL" scale="0.0060 0.0060 0.0060" />
      </geometry>
      <material name="body_color">
        <texture />
        <color rgba="0 1 1 0.5" />
      </material>
    </visual>
  </link>
  <joint name="ankle_Z" type="revolute">
    <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <parent link="foot" />
    <child link="lowerleg" />
    <limit effort="500.0" velocity="200.0" lower="-3.14159" upper="3.14159" />
  </joint>
  <!-- TRANSMITION DEFINITION -->
  <transmission name="ankle_transmition">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="ankle_Z">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    </joint>
    <actuator name="ankle_actuator">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
  <link name="lowerleg">
    <inertial>
      <mass value="3.6" />
      <origin rpy="0 -0 0" xyz="0.171 0.02 0.003" />
      <inertia ixx="0.049314" ixy="-0.001006" ixz="-0.000252" iyy="0.00629" iyz="0.001573" izz="0.049314" />
    </inertial>
    <visual>
      <origin rpy="0 0 -1.57" xyz="0.45 0.0 0.1" />
      <geometry>
        <mesh filename="package://meshes/lowerleg_mesh.STL" scale="0.0063 0.0065 0.007" />
      </geometry>
      <material name="body_color">
        <texture />
        <color rgba="0 1 1 0.5" />
      </material>
    </visual>
    <visual>
      <origin rpy="0 0 -1.57" xyz="0.45 0.0 -0.1" />
      <geometry>
        <mesh filename="package://meshes/lowerleg_mesh.STL" scale="0.0063 0.0065 0.007" />
      </geometry>
      <material name="body_color">
        <texture />
        <color rgba="0 1 1 0.5" />
      </material>
    </visual>
  </link>
  <joint name="knee_Z" type="revolute">
    <origin rpy="0 -0 0" xyz="${knee_length} 0.0 0.0"/>
    <axis xyz="0 0 1" />
    <parent link="lowerleg" />
    <child link="upperleg" />
    <limit effort="500.0" velocity="200.0" lower="-0.10" upper="3.14159" />
  </joint>
  <!-- TRANSMITION DEFINITION -->
  <transmission name="knee_transmition">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="knee_Z">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    </joint>
    <actuator name="knee_actuator">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
  <link name="upperleg">
    <inertial>
      <mass value="9.22" />
      <origin rpy="0 -0 0" xyz="0.179 0.017 0.014" />
      <inertia ixx="0.134834" ixy="0.007856" ixz="-0.000641" iyy="0.036073" iyz="-0.007856" izz="0.144293" />
    </inertial>
    <visual>
      <origin rpy="0.0 0 -1.57" xyz="0.05 0.0 0.1" />
      <geometry>
        <mesh filename="package://meshes/knee_mesh.STL" scale="0.006 0.006 0.006" />
      </geometry>
      <material name="body_color">
        <texture />
        <color rgba="0 1 1 0.5" />
      </material>
    </visual>
    <visual>
      <origin rpy="0.0 0 -1.57" xyz="0.05 0.0 -0.1" />
      <geometry>
        <mesh filename="package://meshes/knee_mesh.STL" scale="0.006 0.006 0.006" />
      </geometry>
      <material name="body_color">
        <texture />
        <color rgba="0 1 1 0.5" />
      </material>
    </visual>
    <visual>
      <origin rpy="0 0 -1.57" xyz="0.47 0.0 0.1" />
      <geometry>
        <mesh filename="package://meshes/upperleg_mesh.STL" scale="0.0063 0.0065 0.007" />
      </geometry>
      <material name="body_color">
        <texture />
        <color rgba="0 1 1 0.5" />
      </material>
    </visual>
    <visual>
      <origin rpy="0 0 -1.57" xyz="0.47 0.0 -0.1" />
      <geometry>
        <mesh filename="package://meshes/upperleg_mesh.STL" scale="0.0063 0.0065 0.007" />
      </geometry>
      <material name="body_color">
        <texture />
        <color rgba="0 1 1 0.5" />
      </material>
    </visual>
  </link>
  <joint name="lumbar_Z" type="revolute">
    <origin rpy="0 -0 0" xyz="${hip_length} 0.0 0.0"/>
    <axis xyz="0 0 1" />
    <parent link="upperleg" />
    <child link="trunk" />
    <limit effort="500.0" velocity="200.0" lower="-3.14" upper="3.14159" />
  </joint>
  <!-- TRANSMITION DEFINITION -->
  <transmission name="lumbar_transmition">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="lumbar_Z">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    </joint>
    <actuator name="lumbar_actuator">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
  <link name="trunk">
    <inertial>
      <mass value="35.47" />
      <origin rpy="0 -0 0" xyz="0.116 0.007 -0.001" />
      <inertia ixx="2.592457" ixy="7.005900e-02" ixz="-3.523000e-04" iyy="2.448720e-01" iyz="-4.236600e-03" izz="2.594914" />
    </inertial>
    <visual>
      <origin rpy="0 0 -1.57" xyz="0.05 0.0 0.0" />
      <geometry>
        <mesh filename="package://meshes/pelvis_mesh.STL" scale="0.006 0.0055 0.0055" />
      </geometry>
      <material name="body_color">
        <texture />
        <color rgba="0 1 1 0.5" />
      </material>
    </visual>
    <visual>
      <origin rpy="0 -0 -1.57" xyz="0.06 0.0 0.0" />
      <geometry>
        <mesh filename="package://meshes/abdomen_mesh.STL" scale="0.0055 0.0055 0.0055" />
      </geometry>
      <material name="body_color">
        <texture />
        <color rgba="0 1 1 0.5" />
      </material>
    </visual>
    <visual>
      <origin rpy="0 0 -1.57" xyz="0.0 0.0 0.0" />
      <geometry>
        <mesh filename="package://meshes/torso_mesh.STL" scale="0.0065 0.0065 0.0065" />
      </geometry>
      <material name="body_color">
        <texture />
        <color rgba="0.2 0.2 0.2 0.2" />
      </material>
    </visual>
    <visual>
      <origin rpy="0 0 -1.57" xyz="0.5 0.0 0.0" />
      <geometry>
        <mesh filename="package://meshes/head_mesh.STL" scale="0.0055 0.0055 0.0055" />
      </geometry>
      <material name="body_color">
        <texture />
        <color rgba="0.2 0.2 0.2 0.5" />
      </material>
    </visual>
    <visual>
      <origin rpy="0 0.0 0" xyz="0.5 -0.0 0.0" />
      <geometry>
        <mesh filename="package://meshes/neck_mesh.STL" scale="0.005 0.005 0.005" />
      </geometry>
      <material name="body_color">
        <texture />
        <color rgba="0.2 0.2 0.2 0.7" />
      </material>
    </visual>
  </link>
  <joint name="shoulder_Z" type="revolute">
    <origin rpy="0 -0 0" xyz="${shoulder_length} 0.0 0.0"/>
    <axis xyz="0 0 1" />
    <parent link="trunk" />
    <child link="upperarm" />
    <limit effort="500.0" velocity="200.0" lower="-4.01" upper="1.5708" />
  </joint>
  <!-- TRANSMITION DEFINITION -->
  <transmission name="shoulder_transmition">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="shoulder_Z">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    </joint>
    <actuator name="shoulder_actuator">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
  <link name="upperarm">
    <inertial>
      <mass value="1.8" />
      <origin rpy="0 -0 0" xyz="0.118 -0.004 -0.007" />
      <inertia ixx="0.011874" ixy="0.000445" ixz="0.000309" iyy="0.002422" iyz="4.9e-05" izz="0.012652" />
    </inertial>
    <visual>
      <origin rpy="0 0 1.57" xyz="0.0 0.0 0.15" />
      <geometry>
        <mesh filename="package://meshes/shoulder_mesh.STL" scale="0.0055 0.0055 0.0055" />
      </geometry>
      <material name="body_color">
        <texture />
        <color rgba="0 1 1 0.5" />
      </material>
    </visual>
    <visual>
      <origin rpy="0 0 1.57" xyz="0.0 0.0 0.15" />
      <geometry>
        <mesh filename="package://meshes/upperarm_mesh.STL" scale="0.0063 0.0060 0.007" />
      </geometry>
      <material name="body_color" />
    </visual>
    <visual>
      <origin rpy="0 0 1.57" xyz="0.0 0.0 -0.15" />
      <geometry>
        <mesh filename="package://meshes/shoulder_mesh.STL" scale="0.0055 0.0055 0.0055" />
      </geometry>
      <material name="body_color">
        <texture />
        <color rgba="0 1 1 0.5" />
      </material>
    </visual>
    <visual>
      <origin rpy="0 0 1.57" xyz="0.0 0.0 -0.15" />
      <geometry>
        <mesh filename="package://meshes/upperarm_mesh.STL" scale="0.0063 0.0060 0.007" />
      </geometry>
      <material name="body_color" />
    </visual>
  </link>
  <joint name="elbow_Z" type="revolute">
    <origin rpy="0 -0 0" xyz="${elbow_length} 0.0 0.0"/>
    <axis xyz="0 0 1" />
    <parent link="upperarm" />
    <child link="lowerarm" />
    <limit effort="500.0" velocity="200.0" lower="-0.10" upper="2.96706" />
  </joint>
  <!-- TRANSMITION DEFINITION -->
  <transmission name="elbow_transmition">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="elbow_Z">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    </joint>
    <actuator name="elbow_actuator">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
  <link name="lowerarm">
    <inertial>
      <mass value="1.28" />
      <origin rpy="0 -0 0" xyz="0.114 -0.003 0.004" />
      <inertia ixx="0.007479" ixy="8.6e-05" ixz="3.8e-05" iyy="0.001154" iyz="-0.000611" izz="0.006954" />
    </inertial>
    <visual>
      <origin rpy="0 0 1.57" xyz="0.02 0. 0.15" />
      <geometry>
        <mesh filename="package://meshes/elbow_mesh.STL" scale="0.0055 0.0055 0.0055" />
      </geometry>
      <material name="body_color">
        <texture />
        <color rgba="0 1 1 0.5" />
      </material>
    </visual>
    <visual>
      <origin rpy="0 0 1.57" xyz="0.03 0.0 0.15" />
      <geometry>
        <mesh filename="package://meshes/lowerarm_mesh.STL" scale="0.0060 0.0060 0.0060" />
      </geometry>
      <material name="body_color">
        <texture />
        <color rgba="0 1 1 0.5" />
      </material>
    </visual>
    <visual>
      <origin rpy="0 0 1.57" xyz="0.02 0.0 -0.15" />
      <geometry>
        <mesh filename="package://meshes/elbow_mesh.STL" scale="0.0055 0.0055 0.0055" />
      </geometry>
      <material name="body_color">
        <texture />
        <color rgba="0 1 1 0.5" />
      </material>
    </visual>
    <visual>
      <origin rpy="0 0 1.57" xyz="0.03 0.0 -0.15" />
      <geometry>
        <mesh filename="package://meshes/lowerarm_mesh.STL" scale="0.0060 0.0060 0.0060" />
      </geometry>
      <material name="body_color">
        <texture />
        <color rgba="0 1 1 0.5" />
      </material>
    </visual>
  </link>
  <joint name="hand_fixed" type="fixed">
    <origin rpy="0 -0 0" xyz="${wrist_length} 0.0 0.0"/>
    <axis xyz="0 0 1" />
    <parent link="lowerarm" />
    <child link="hand" />
    <limit effort="500.0" velocity="200.0" lower="-1.5708" upper="1.5708" />
  </joint>
  <link name="hand">
    <inertial>
      <mass value="0.45" />
      <origin rpy="0 -0 0" xyz="0.015 -0.154 0.014" />
      <inertia ixx="0.005608" ixy="0.000729" ixz="0.000339" iyy="0.002176" iyz="-0.000603" izz="0.004726" />
    </inertial>
    <visual>
      <origin rpy="0 0 1.57" xyz="0.035 0.0 0.15" />
      <geometry>
        <mesh filename="package://meshes/hand_mesh.STL" scale="0.0060 0.0060 0.0060" />
      </geometry>
      <material name="body_color">
        <texture />
        <color rgba="0 1 1 0.5" />
      </material>
    </visual>
    <visual>
      <origin rpy="0 0 1.57" xyz="0.035 0.0 -0.15" />
      <geometry>
        <mesh filename="package://meshes/hand_mesh.STL" scale="0.0060 0.0060 0.0060" />
      </geometry>
      <material name="body_color">
        <texture />
        <color rgba="0 1 1 0.5" />
      </material>
    </visual>
  </link>
  <gazebo>
    <plugin name="gazebo_ros_control_human" filename="libgazebo_ros_control.so">
      <controlPeriod>0.01</controlPeriod>
      <robotNamespace>/human</robotNamespace>
      <robotSimType>rt-cosmik/HumanGazeboHW</robotSimType>
    </plugin>
    <!-- <self_collide>true</self_collide> -->
  </gazebo>
</robot>